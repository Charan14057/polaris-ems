# ============================================================
# POLARIS-EMS — Production Environment Configuration Template
# SIH26061: Polar Energy Management & Resilience System
# ============================================================
# Copy this file to .env and configure values for your deployment.
# DO NOT commit .env files with real credentials to version control.
# ============================================================

# --- 1. Application & Server Configuration ---
POLARIS_API_HOST=0.0.0.0
POLARIS_API_PORT=8000
POLARIS_WORKERS=1
POLARIS_LOG_LEVEL=INFO
POLARIS_DEBUG=false
POLARIS_SHUTDOWN_TIMEOUT_SEC=15.0

# --- 2. Security & CORS Hardening ---
# Comma-separated list of allowed frontend origin URLs
POLARIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Maximum request body size in bytes (default: 10MB)
POLARIS_MAX_REQUEST_BYTES=10485760
# Enable standard HTTP security headers (HSTS, X-Frame-Options, CSP)
POLARIS_SECURITY_HEADERS=true

# --- 3. Deployment & Environment Mode ---
# Environment classifier: LOCAL_INTEGRATED, DOCKER_COMPOSE, STAGING, PRODUCTION
POLARIS_ENVIRONMENT=LOCAL_INTEGRATED
# Enable FastAPI to serve pre-built React static bundle on the same port
POLARIS_SERVE_FRONTEND=false
POLARIS_FRONTEND_DIST=frontend/dist

# --- 4. Trace & Audit Repository ---
# Maximum traces retained per station before local FIFO rotation
POLARIS_TRACE_RETENTION_LIMIT=500
POLARIS_TRACE_DIR=reports/traces

# --- 5. External Reality Bridge & Weather Providers (Workstream C) ---
# Enable external data adapters (default: false, maintaining offline resilience)
POLARIS_EXTERNAL_DATA_ENABLED=false
# External HTTP request timeout in seconds
POLARIS_EXTERNAL_TIMEOUT_SEC=10.0
# Maximum allowed age of external observation before marked STALE (seconds)
POLARIS_EXTERNAL_MAX_FRESHNESS_SEC=3600
# Rate limit for outbound requests to external APIs (requests per minute)
POLARIS_EXTERNAL_RATE_LIMIT_RPM=60
# External meteorological API endpoints
POLARIS_OPENMETEO_ENDPOINT=https://api.open-meteo.com/v1/forecast
# Optional NCPOR or Arctic/Antarctic telemetry gateway endpoint (if commissioned)
# POLARIS_NCPOR_GATEWAY_URL=
# Optional provider API key
# POLARIS_WEATHER_API_KEY=

# --- 6. Operator Mode & Physical Connectivity ---
# Operational Mode: ADVISORY (default), SUPERVISED_DISPATCH, SIMULATION_OFFLINE
POLARIS_OPERATOR_MODE=ADVISORY
# NOTE: Polaris-EMS enforces that physical_scada_connected is strictly False
# as no physical SCADA connection to Antarctica or the Arctic currently exists.
